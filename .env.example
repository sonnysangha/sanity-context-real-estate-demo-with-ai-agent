# Sign up at https://www.sanity.io/sonny and create YOUR project.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Project viewer token: public catalogue reads on the Next.js server.
SANITY_API_READ_TOKEN=
# Local seed/reset only. Never expose as NEXT_PUBLIC or deploy this token.
SANITY_API_WRITE_TOKEN=
# Copy the endpoint URL from Sanity Dashboard > Context.
SANITY_CONTEXT_MCP_URL=
SANITY_ORGANIZATION_ID=
SANITY_ORGANIZATION_TOKEN=
# Use one model provider. AI_MODEL can override the provider's default model.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_MODEL=

# Opt in to storing chat transcripts and classifying them in Context Insights.
SANITY_INSIGHTS_ENABLED=false
# Optional analysis model override, using the same provider as the chat.
INSIGHTS_MODEL=
